# Copy to .env.local for local overrides, or set this as an Environment
# Variable in your Vercel/Netlify project settings.
#
# Local dev: leave unset - package.json's "proxy" field forwards /api to
# http://localhost:8000 automatically.
#
# Production: set this to your deployed Render backend URL + /api, e.g.
REACT_APP_API_BASE=https://signalloop-backend.onrender.com/api
